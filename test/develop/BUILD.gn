import("../../serialmgr.gni")

config("serialsrv_errcode_private_config") {
  include_dirs = [
    "${serial_manager_path}/interfaces/innerkits/native/include",
    "${serial_manager_path}/utils/native/include",
  ]
}

config("serialsrv_errcode_public_config") {
  include_dirs = [
    "${serial_manager_path}/services/native/include",
    "${serial_manager_path}/interfaces/innerkits/native/include",
    "${serial_manager_path}/utils/native/include",
  ]
}

ohos_shared_library("serialservice_errcodetest") {
  sanitize = {
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  branch_protector_ret = "pac_ret"

  defines = [ "SERIAL_ERROR_CODE_TEST" ]

  cflags_cc = [
    "-Wno-unused-variable",
    "-Wno-unused-function",
  ]

  install_enable = false
  sources = [
    "${serial_manager_path}/services/native/src/serial_service.cpp",
  ]

  configs = [
    ":serialsrv_errcode_private_config",
  ]

  public_configs = [ ":serialsrv_errcode_public_config" ]
  deps = [ "${serial_manager_path}/interfaces/innerkits:serial_server_stub" ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
  ]

  shlib_type = "sa"
  subsystem_name = "busmanager"
  part_name = "serial_manager"
}
