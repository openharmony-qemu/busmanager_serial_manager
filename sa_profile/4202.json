{
    "process": "serial_service",
    "systemability": [
        {
            "name": 4202,
            "libpath": "libserialservice.z.so",
            "run-on-create": false,
            "auto-restart": true,
            "distributed": false,
            "dump_level": 1,
            "min_hdi_proxy_version": ["libserials_proxy_1.0.z.so"],
            "start-on-demand": {
                "param": [
                    {
                        "name": "persist.edm.rs232_serial_disable",
                        "value": "1"
                    },
                    {
                        "name": "persist.edm.rs232_serial_disable",
                        "value": "0"
                    }
                ]
            }
        }
    ]
}
