import("./../../../../serialmgr.gni")

config("serialnapi_private_config") {
  include_dirs = [
    "${serial_manager_path}/interfaces/kits/js/napi/include",
    "${serial_manager_path}/interfaces/innerkits/native/include",
    "${serial_manager_path}/utils/native/include",
  ]
}

ohos_shared_library("serial") {
  sanitize = {
    integer_overflow = true
    ubsan = true
    boundary_sanitize = true
  }

  defines = [ "SERIAL_NAPI" ]

  sources = [ "src/serial_info.cpp" ]
  deps = [
    "${serial_manager_path}/interfaces/innerkits:serialsrv_client",
    "${serial_manager_path}/utils:serial_error_code",
  ]
  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "napi:ace_napi",
    "samgr:samgr_proxy",
  ]

  configs = [ ":serialnapi_private_config" ]

  relative_install_dir = "module/busmanager"

  subsystem_name = "busmanager"
  part_name = "serial_manager"
}
