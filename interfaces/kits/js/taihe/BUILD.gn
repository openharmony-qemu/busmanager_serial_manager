import("//build/config/components/ets_frontend/ets2abc_config.gni")
import("//build/ohos.gni")
import("//build/ohos/taihe_idl/taihe.gni")
import("../../../../serialmgr.gni")

copy_taihe_idl("copy_serial_manager") {
  sources = [ "idl/ohos.busManager.serial.taihe" ]
}

subsystem_name = "busmanager"
part_name = "serial_manager"
taihe_generated_file_path = "$taihe_file_path/out/$subsystem_name/$part_name"

ohos_taihe("run_taihe") {
  taihe_generated_file_path = "$taihe_generated_file_path"
  deps = [ ":copy_serial_manager" ]
  outputs = [
    "$taihe_generated_file_path/src/ohos.busManager.serial.ani.cpp",
    "$taihe_generated_file_path/src/ohos.busManager.serial.abi.c",
  ]
}

if (serial_manager_feature_deploy_sa) {
  taihe_impl_sources = [ "src/ohos.busManager.serial.impl.cpp" ]
  taihe_extra_deps = [
    "${serial_manager_path}/interfaces/innerkits:serialsrv_client",
    "${serial_manager_path}/utils:serial_error_code",
  ]
  taihe_external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "napi:ace_napi",
    "runtime_core:ani_helpers",
    "samgr:samgr_proxy",
  ]
} else {
  taihe_impl_sources = [ "src/ohos.busManager.serial.without_service.cpp" ]
  taihe_extra_deps = []
  taihe_external_deps = [
    "hilog:libhilog",
    "runtime_core:ani_helpers",
  ]
}

taihe_shared_library("serial_manager_taihe_native") {
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  taihe_generated_file_path = "$taihe_generated_file_path"
  part_name = "$part_name"
  subsystem_name = "$subsystem_name"
  sources = get_target_outputs(":run_taihe")

  sources += [ "src/ani_constructor.cpp" ]
  sources += taihe_impl_sources

  include_dirs = [
    "${serial_manager_path}/interfaces/innerkits/native/include",
    "${serial_manager_path}/utils/native/include",
  ]

  deps = [ ":run_taihe" ]
  deps += taihe_extra_deps

  external_deps = taihe_external_deps
}

generate_static_abc("serial_manager_abc") {
  base_url = "$taihe_generated_file_path"
  files = [ "$taihe_generated_file_path/@ohos.busManager.serial.ets" ]
  is_boot_abc = "True"
  device_dst_file = "/system/framework/serial_manager_abc.abc"
  dependencies = [ ":run_taihe" ]
}

ohos_prebuilt_etc("serialmanager_etc") {
  source = "$target_out_dir/serial_manager_abc.abc"
  module_install_dir = "framework"
  part_name = "$part_name"
  subsystem_name = "$subsystem_name"
  deps = [ ":serial_manager_abc" ]
}

group("serial_manager_taihe") {
  deps = [
    ":serial_manager_taihe_native",
    ":serialmanager_etc",
  ]
}
