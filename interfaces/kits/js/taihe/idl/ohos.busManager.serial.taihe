@!namespace("@ohos.busManager.serial", "serial")
@!sts_inject("""loadLibraryWithPermissionCheck("serial_manager_taihe_native.z", "@ohos.busManager.serial")""")

@gen_promise("getSerialPortList")
function getSerialPortListSync(): Array<SerialPort>;

@gen_promise("addPortAuthorization")
function addPortAuthorizationSync(tokenId: String, deviceId: String): void;

interface SerialPort {

  @get getPortInfo(): SerialPortInfo;

  @promise open(@optional config: Optional<SerialConfigs>): void;

  @promise close(): void;

  @promise write(data: @typedarray Array<u8>, @optional timeout: Optional<i32>): i32;

  onDataRead(callback: (data: @typedarray Array<u8>) => void): void;

  offDataRead(@optional callback: Optional<(data: @typedarray Array<u8>) => void>): void;

  @promise flush(): void;

  @promise drain(): void;

  @promise setRts(enable: bool): void;

  @promise getCts(): bool;

  @promise sendBrk(): void;
}

struct SerialPortInfo {

  portName: String;

  @optional productId: Optional<i32>;

  @optional vendorId: Optional<i32>;

  @optional manufacturer: Optional<String>;
}

struct SerialConfigs {

  @optional baudRate: Optional<i32>;

  @optional dataBits: Optional<DataBits>;

  @optional stopBits: Optional<StopBits>;

  @optional parity: Optional<Parity>;

  @optional rtscts: Optional<bool>;

  @optional xon: Optional<bool>;

  @optional xoff: Optional<bool>;

  @optional xany: Optional<bool>;
}

enum DataBits : i32 {

  FIVE = 5,

  SIX = 6,

  SEVEN = 7,

  EIGHT = 8
}

enum StopBits : i32 {

  ONE = 1,

  TWO = 2
}

enum Parity : String {

  NONE = "none",

  EVEN = "even",

  ODD = "odd",

  MARK = "mark",

  SPACE = "space"
}
