import SerialServerTypes;
import ISerialServiceCallback;

/**
 * @brief Serial management service interface
 * @since 7.0
 * @version 1.0
 */
interface OHOS.Serial.ISerialServer {
    /**
     * @brief Query list of available serial devices.
     *
     * @param devices Indicates output list of serial device info.
     * @return Returns <b>0</b> if operation is successful.
     * @return Returns a non-zero value if operation fails.
     * @since 7.0
     */
    void QuerySerialDevices([out] SerialPortInfo[] devices);

    /**
     * @brief Open a serial device with specified configuration.
     *
     * @param portInfo Indicates serial port information.
     * @param config Indicates serial configuration.
     * @param token Indicates IRemoteObject token for client death notification.
     * @return Returns <b>0</b> if operation is successful.
     * @return Returns a non-zero value if operation fails.
     * @since 7.0
     */
    void OpenSerial([in] SerialPortInfo portInfo, [in] SerialConfig config, [in] ISerialServiceCallback cb);

    /**
     * @brief Close a serial device.
     *
     * @param portName Indicates device port name to close.
     * @return Returns <b>0</b> if operation is successful.
     * @return Returns a non-zero value if operation fails.
     * @since 7.0
     */
    void CloseSerial([in] String portName);

    /**
     * @brief Write data to a serial device.
     *
     * @param portName Indicates device port name.
     * @param data Indicates data to write.
     * @param timeout Indicates timeout in milliseconds.
     * @param bytesWritten Indicates output number of bytes written.
     * @return Returns <b>0</b> if operation is successful.
     * @return Returns a non-zero value if operation fails.
     * @since 7.0
     */
    void WriteSerial([in] String portName, [in] unsigned char[] buffer, [in] int timeout, [out] int bytesWritten);

    void StartRead([in] String portName);
    void StopRead([in] String portName);

    /**
     * @brief Flush buffer of a serial device.
     *
     * @param portName Indicates device port name.
     * @return Returns <b>0</b> if operation is successful.
     * @return Returns a non-zero value if operation fails.
     * @since 7.0
     */
    void Flush([in] String portName);

    /**
     * @brief Wait for all write operations to complete.
     *
     * @param portName Indicates device port name.
     * @return Returns <b>0</b> if operation is successful.
     * @return Returns a non-zero value if operation fails.
     * @since 7.0
     */
    void Drain([in] String portName);

    /**
     * @brief Send BRK signal of a serial device.
     *
     * @param portName Indicates device port name.
     * @return Returns <b>0</b> if operation is successful.
     * @return Returns a non-zero value if operation fails.
     * @since 7.0
     */
    void SendBrkSignal([in] String portName);

    /**
     * @brief Set RTS signal of a serial device.
     *
     * @param portName Indicates device port name.
     * @param rts Indicates RTS signal state.
     * @return Returns <b>0</b> if operation is successful.
     * @return Returns a non-zero value if operation fails.
     * @since 7.0
     */
    void SetRtsSignal([in] String portName, [in] boolean rts);

    /**
     * @brief Get CTS signal of a serial device.
     *
     * @param portName Indicates device port name.
     * @param cts Indicates output CTS signal state.
     * @return Returns <b>0</b> if operation is successful.
     * @return Returns a non-zero value if operation fails.
     * @since 7.0
     */
    void GetCtsSignal([in] String portName, [out] boolean cts);

    /**
     * @brief Add port authorization (system permission).
     *
     * @param authToken Indicates access token.
     * @param deviceId Indicates device ID.
     * @return Returns <b>0</b> if operation is successful.
     * @return Returns a non-zero value if operation fails.
     * @since 7.0
     */
    void AddPortAuthorization([in] String authToken, [in] String deviceId);
}
