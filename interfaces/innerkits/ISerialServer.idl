import SerialServerTypes;
import ISerialServiceCallback;

interface OHOS.Serial.ISerialServer {
    void QuerySerialDevices([out] SerialPortInfo[] devices);

    void OpenSerial([in] SerialPortInfo portInfo, [in] SerialConfig config, [in] ISerialServiceCallback cb);

    void CloseSerial([in] String portName);

    void WriteSerial([in] String portName, [in] unsigned char[] buffer, [in] int timeout, [out] int bytesWritten);

    void StartRead([in] String portName);
    void StopRead([in] String portName);

    void Flush([in] String portName);

    void Drain([in] String portName);

    void SendBrkSignal([in] String portName);

    void SetRtsSignal([in] String portName, [in] boolean rts);

    void GetCtsSignal([in] String portName, [out] boolean cts);

    void SetDtrSignal([in] String portName, [in] boolean dtr);

    void GetDsrSignal([in] String portName, [out] boolean dsr);

    void AddPortAuthorization([in] String authToken, [in] String deviceId);
}
